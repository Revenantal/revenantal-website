# Live-job runtime settings. Copy to deploy/.env.live on the host; never commit
# the copy. Every variable the job reads is listed here (a test enforces it).

# GitHub: anonymous requests cover six refreshes/hour. A token is optional.
# GITHUB_TOKEN=

# Steam: both are needed or Steam stays unavailable. STEAM_ID is 17 digits.
# STEAM_KEY=
# STEAM_ID=

# Pelican: restricted status-bot Client API key (zero subuser permissions).
PELICAN_URL=https://panel.example.invalid
PELICAN_KEY=
# Shared game hostname; each server is queried on its own allocation port.
GAME_QUERY_HOST=games.revenantal.com

# Paths inside the container. The defaults suit live-job.compose.example.yml.
# LIVE_PATH=/data/live.json
# SITE_PATH=/app/site.json
# Private network-rate baselines; defaults beside LIVE_PATH. Empty disables.
# PELICAN_STATE_PATH=/data/pelican-state.json
