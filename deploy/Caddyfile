{
	admin off
	auto_https off
	persist_config off
	log default {
		level WARN
	}
}

:{$PORT:8080} {
	root * "{$SITE_ROOT:/srv/site}"
	encode zstd gzip
	header -Server
	header {
		Cache-Control no-cache
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}

	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}

	handle /live.json {
		root * "{$LIVE_ROOT:/srv/revenantal-live}"
		header Cache-Control "max-age=60"
		file_server
	}

	@weather path /api/forecast /api/radar /api/radar/*
	handle @weather {
		header Cache-Control "private, no-store"
		header Content-Type application/json
		respond `{"error":"weather_unavailable"}` 503
	}

	handle /api/* {
		header Cache-Control no-store
		respond 404
	}

	@hashed path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(js|css)$
	handle @hashed {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		file_server {
			hide .git .env .env.*
		}
	}
}
