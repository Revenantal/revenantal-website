# Compose settings for live-job.compose.example.yml. Copy to deploy/.env on the
# host; never commit the copy. Credentials belong in .env.live, not here.

# Verified commit SHA of the site/live-job images to run.
SITE_TAG=

# Weather (off by default; enable only after the task 3.7 checks).
# The edge proxy's exact address or CIDR, trusted to name the visitor's address.
TRUSTED_EDGE=
# The private forecast service, for example forecast:8090. Unset keeps weather off.
FORECAST_UPSTREAM=
